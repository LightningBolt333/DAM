<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/characterListFragment">

    <fragment
        android:id="@+id/characterListFragment"
        android:name="com.example.xardcalamityfiles.ui.list.CharacterListFragment"
        android:label="Character List"
        tools:layout="@layout/fragment_character_list">
        <action
            android:id="@+id/action_characterListFragment_to_characterDetailsFragment"
            app:destination="@id/characterDetailsFragment" />
        <action
            android:id="@+id/action_characterListFragment_to_characterCreateFragment"
            app:destination="@id/characterCreateFragment" />
    </fragment>

    <fragment
        android:id="@+id/characterDetailsFragment"
        android:name="com.example.xardcalamityfiles.ui.details.CharacterDetailsFragment"
        android:label="Character Details"
        tools:layout="@layout/fragment_character_details">
        <argument
            android:name="characterId"
            app:argType="long" />
        <action
            android:id="@+id/action_characterDetailsFragment_to_characterCreateFragment"
            app:destination="@id/characterCreateFragment" />
    </fragment>

    <fragment
        android:id="@+id/characterCreateFragment"
        android:name="com.example.xardcalamityfiles.ui.create.CharacterCreateFragment"
        android:label="Create Character"
        tools:layout="@layout/fragment_character_create">
        <argument
            android:name="characterId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>
        
</navigation>
